{
  "name": "zts-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Zero Trust Security - secure Matrix collaboration and administration platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @zts/database db:generate",
    "db:migrate": "pnpm --filter @zts/database db:migrate",
    "db:seed": "pnpm --filter @zts/database db:seed",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@zts/auth": "workspace:^",
    "@zts/database": "workspace:^",
    "drizzle-orm": "^0.45.2"
  }
}

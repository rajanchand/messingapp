# ============================================================
# Reverse proxy example for the admin panel.
# IMPORTANT: Inspect your existing VPS reverse proxy before deploying.
# Do not replace the config that serves chat.zero-trust-security.org.
#
# Checklist (also in docs/DEPLOYMENT.md):
# [ ] Dedicated vhost for ADMIN_DOMAIN only
# [ ] TLS 1.2+ / ACME
# [ ] HSTS
# [ ] Proxy to 127.0.0.1:3000
# [ ] Forward X-Forwarded-For
# [ ] Preserve Host / Origin (CSRF)
# [ ] Smoke-test /api/health after reload
# ============================================================

admin.chat.zero-trust-security.org {
	# TLS via Let's Encrypt is automatic with Caddy.

	encode gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The admin app listens on localhost only.
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}

# ============================================================
# Zero Trust Security platform - environment configuration
# Copy to .env and fill in values. NEVER commit real secrets.
# ============================================================

# --- Branding ---
APP_NAME="Zero Trust Security"
# Client-visible app name (inlined at build time).
NEXT_PUBLIC_APP_NAME="Zero Trust Security"
APP_LOGO=/branding/logo.svg
APP_FAVICON=/branding/favicon.svg
SUPPORT_EMAIL=support@zero-trust-security.org

# --- Domains ---
ADMIN_DOMAIN=admin.chat.zero-trust-security.org

# --- Matrix / Synapse ---
# Public base URL of the existing Synapse homeserver.
MATRIX_HOMESERVER=https://chat.zero-trust-security.org
# The Matrix server_name (domain part of user IDs).
MATRIX_SERVER_NAME=chat.zero-trust-security.org
# Access token of a Synapse admin account. Server-side only.
# Create with: login as an admin user and copy the access token,
# or use `register_new_matrix_user -a` then log in.
MATRIX_ADMIN_TOKEN=

# --- Application database (dedicated, NOT the Synapse database) ---
DATABASE_URL=postgres://zts:change-me@localhost:5433/zts

# --- Redis (rate limiting, lockout, cache) ---
REDIS_URL=redis://localhost:6380

# --- Sessions ---
# 32+ random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# --- WebAuthn (optional overrides; defaults from ADMIN_DOMAIN) ---
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_ORIGIN=http://localhost:3000

# --- AI assistant (optional OpenAI-compatible endpoint) ---
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# --- Automation worker ---
AUTOMATION_CONCURRENCY=5

# --- SMTP (welcome emails on user create) ---
# When set, creating a user emails username + temporary password and
# Element X change-password instructions to the given address.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Zero Trust Security <noreply@zero-trust-security.org>"
# SMTP_SECURE=false
# ELEMENT_X_HINT_URL=https://element.io/download

# --- Runtime ---
NODE_ENV=development
